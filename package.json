{
  "name": "pa-smc-trading-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,green \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@openai/codex": "0.163.0",
    "@phosphor-icons/react": "^2.1.10",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "https-proxy-agent": "^9.1.0",
    "lightweight-charts": "^5.0.9",
    "papaparse": "^5.5.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "undici": "^7.30.1",
    "ws": "^8.22.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
