# 仅服务端读取；不要使用 VITE_ 前缀，不要把真实密钥提交到 Git。
# auto 优先使用已登录 ChatGPT 的本机 Codex，再选择已配置的 API，否则模拟。
# 网页可显式选择来源；Codex 失败绝不自动改用 API 计费。
AI_PROVIDER=auto

# Codex 订阅额度：先安装官方 CLI 并执行 codex login（使用 ChatGPT 登录）。
# 留空自动使用项目安装的官方运行时；也可指定原生 codex.exe / codex 的绝对路径。
CODEX_BIN=
# 留空使用 Codex CLI 默认模型；也可填写该账号实际可用的模型 ID。
CODEX_MODEL=
# 留空使用CLI模型默认强度；可选值须受所选模型支持，例如 high。
CODEX_REASONING_EFFORT=
# fast 启用快速模式（更高额度消耗）；留空不覆盖CLI速度默认值。
CODEX_SERVICE_TIER=
CODEX_TIMEOUT_MS=180000
# Codex 网络需要代理时单独配置（例如 http://127.0.0.1:7890），留空使用进程原有网络环境。
CODEX_PROXY_URL=

# 独立 API 模式才需要 Key 与模型，不使用 Codex 订阅额度。
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini

# 优先使用支持严格 Structured Outputs 的模型。
# 若供应商只支持 JSON mode，可显式切换为 json_object；两种模式均进行本地校验。
AI_RESPONSE_FORMAT=json_schema
AI_TIMEOUT_MS=45000

HOST=127.0.0.1
PORT=3001

# 公共行情接口不需要交易所 Key。网络需要 HTTP 代理时显式配置，留空直连。
MARKET_PROXY_URL=

# Binance USDⓈ-M只读账户；仅服务端读取。请在交易所关闭交易/提现权限，并尽可能设置IP白名单。
# 支持HMAC API Key。只读适配器固定访问fapi.binance.com的五个GET接口，无任何执行能力。
# 留空时账户功能显示未配置；不会自动连接。配置后重启服务，在设置中点击“测试并连接”。
BINANCE_API_KEY=
BINANCE_API_SECRET=
